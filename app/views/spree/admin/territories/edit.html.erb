<%= render partial: 'spree/admin/users/tabs', locals: { current: :territories } %>

<% content_for :title do %>
  <%= "Spree #{Spree.t('administration')}: #{Spree.t(:"admin.user.territories")}" %>
<% end %>

<script>

  Spree.routes.states_api_v2 = Spree.pathFor('api/v2/platform/states')

</script>

<div data-hook="admin_user_territories" class="card mb-3">
  <div class="card-header">
    <h5 class="card-title mb-0 h6">
      <%= Spree.t(:"admin.user.territories") %>
    </h5>
  </div>
  <div class="card-body">
    <%= form_for @user, method: :put, url: spree.admin_user_territories_path(@user) do |f| %>
      <div data-hook="admin_user_territories_form_fields" class="row">
        <div class="col-12">
          <%= f.field_container :country_id do %>
            <%= f.label :country_id, Spree.t(:country) %>
            <div id="scountry">
                <%= f.collection_select :country_id, all_countries, :id, :name, {}, { class: 'select2 w-100' } %>
            </div>
          <% end %>

          <%= f.field_container :states do %>
            <%= f.label :states, Spree.t(:states) %>

            <% if can? :modify, Spree::User %>
              <div id="sstate">
                <% if f.object.country.try(:states) %>
                  <%= f.text_field :states,
                                  style: "display: #{f.object.country.try(:states) && f.object.country.states.empty? ? 'block' : 'none' };",
                                  disabled: !(f.object.country.try(:states) && f.object.country.states.empty?), class: 'form-control state_name' %>
                  <%= f.collection_select :states, f.object.country.states.sort, :id, :name, { selected: @user.state_ids, include_blank: false }, { class: 'select2 w-100', multiple: true, disabled: f.object.country.states.empty? } %>
                <% else %>
                  <div>
                    <em><%= Spree.t(:no_country) %></em>
                  </div>
                <% end %>
              </div>
            <% elsif @user.states.any? %>
              <ul class="text_list">
                <% @user.states.each do |state| %>
                  <li><%= state.name %></li>
                <% end %>
              </ul>
            <% else %>
              <div class="alert alert-info"><%= Spree.t(:no_resource_found, resource: :states) %></div>
            <% end %>
          <% end %>
        </div>
      </div>
      <%= render partial: 'spree/admin/shared/edit_resource_links', locals: { collection_url: spree.admin_user_territories_path(@user) } %>
    <% end %>
  </div>
</div>

<% content_for :head do %>
  <script>
    document.addEventListener("spree:load", function() {
      $('#scountry select').on('change', function() { 
        console.log('Update!');
        updateAddressState('s'); 
        });
    })
  </script>
<% end %>