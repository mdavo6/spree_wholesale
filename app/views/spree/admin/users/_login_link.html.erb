<% if @user.lead? && @user.authentication_token.present? %>
  <div data-hook="admin_user_auto_login_link" class="card mb-3">
    <div class="card-header">
      <h5 class="card-title mb-0 h6">
        <%= Spree.t(:automatic_login_link) %>
      </h5>
    </div>
    <div class="card-body">
      <div class="form-group">
        <label for="loginLink">Australian Login Link</label>
        <input type='text' data-link-code=true id='loginLink' value='<%= root_url(user_email: @user.email, user_token: @user.authentication_token, subdomain: 'wholesale', tld_length: 2) %>' class='form-control referral-url-field' />
      </div>
      <div class="form-group">
        <button class="btn btn-primary btn-copylink" data-copy-link-code=true type="button" title='Copy login link'><span class='glyphicon glyphicon-copy'></span></button>
      </div>
    </div>
    <div class="card-body">
      <div class="form-group">
        <label for="loginLink">US Login Link</label>
        <input type='text' data-link-code-us=true id='loginLink' value='<%= root_url(user_email: @user.email, user_token: @user.authentication_token, subdomain: 'wholesale', tld_length: 2).sub('.com.au', '.com') %>' class='form-control referral-url-field' />
      </div>
      <div class="form-group">
        <button class="btn btn-primary btn-copylink" data-copy-link-code-us=true type="button" title='Copy login link'><span class='glyphicon glyphicon-copy'></span></button>
      </div>
    </div>
  </div>
<% end %>
